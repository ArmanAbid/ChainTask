# Network to target. Mainnet | Preview | Preprod.
# Use Preview during the hackathon.
VITE_NETWORK=Preview

# Blockfrost API project ID. Get one at https://blockfrost.io
# Must match the network above (preview project ID for Preview network).
VITE_BLOCKFROST_PROJECT_ID=

# Optional: override the Blockfrost base URL.
# Defaults to the official endpoint for the selected network.
# VITE_BLOCKFROST_URL=

# Pinata JWT for pinning job descriptions, work submissions, and dispute
# evidence to IPFS. Get one at https://app.pinata.cloud
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ─────────────────────────────────────────────────────────────────────
# CONTRACT ARTIFACTS — leave empty until contracts are deployed in Week 7.
# When VITE_ESCROW_SCRIPT_ADDRESS is set, the app switches from
# empty-state mode to live chain reads.
# ─────────────────────────────────────────────────────────────────────

VITE_ESCROW_SCRIPT_ADDRESS=
VITE_REPUTATION_SCRIPT_ADDRESS=
VITE_ADMIN_POLICY_ID=
VITE_ADMIN_ASSET_NAME=