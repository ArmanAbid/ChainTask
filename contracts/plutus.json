              "$ref": "#/definitions/cardano~1address~1Address"
            },
            {
              "title": "job_cid",
              "description": "IPFS CID of the job description JSON. Fixed-length ByteArray.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "amount_lovelace",
              "description": "Locked job payment. Validator enforces this against the GlobalConfig min amount.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "created_at",
              "description": "Block POSIX time at posting / selection / submission. None until reached.\n Stored as milliseconds since epoch (Int).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "selected_at",
              "$ref": "#/definitions/Option$Int"
            },
            {
              "title": "submitted_at",
              "$ref": "#/definitions/Option$Int"
            },
            {
              "title": "auto_release_deadline",
              "description": "Relative seconds. Builder may AutoRelease after submitted_at + this delay.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "auto_refund_deadline",
              "description": "Relative seconds. Client may AutoRefund after selected_at + this delay.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "dispute_raised_by",
              "description": "Address that raised the active dispute, if any.",
